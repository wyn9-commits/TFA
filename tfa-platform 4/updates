@contextmanager
def traced(name: str, inputs: Optional[dict] = None,
           run_type: str = "chain") -> Iterator[dict]:
    """Mirrors `adapters.tracing.traced` exactly, including the yielded dict.

    A facade that silently differs from what it stands in for is worse than no
    facade: this one dropped `run_type` and yielded nothing, so every call site
    using `as out` raised TypeError the moment tracing was exercised.
    """
    backend = _backend()
    if backend is None:
        yield {}
        return
    with backend.traced(name, inputs, run_type) as out:
        yield out


